APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/robot_factor.db
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH_SECRET=replace-with-a-long-random-path

# دسترسی مدیریتی API داخلی
ADMIN_API_KEY=replace-with-a-long-random-key

# فقط این شناسه‌های ثابت اجازه استفاده از ربات را دارند.
# نمونه: telegram:123456789,rubika:u0AbCdEf
ADMIN_IDENTITIES=telegram:123456789,rubika:REPLACE_ME

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-telegram-secret
RUBIKA_BOT_TOKEN=

# مسیر اختیاری Chromium/Chrome. در Docker نیازی به مقداردهی ندارد.
PDF_BROWSER_EXECUTABLE_PATH=
PDF_HEADLESS=true
SESSION_TTL_MINUTES=60
INVOICE_STORAGE_DIR=./data/invoices

